      "CreateUpgradeTicket": {
        "BOE": {
          "description": "创建服务升级工单 (BOE)",
          "http_request_metadata": {
            "method": "POST",
            "url": "https://cloud-boe.bytedance.net/api/v1/tce/open-apis/v1/deployment/cluster/upgrade/",
            "bodySchema": {
              "type": "object",
              "properties": {
                "cluster_info": {
                  "type": "object",
                  "description": "集群信息对象，需包含 runtime.repo_info",
                  "example": {
                    "runtime": {
                      "repo_info": [
                        {
                          "name": "code_forge/pipeline/api",
                          "version": "1.0.0.676",
                          "description": "merge description",
                          "scm_repo_id": "452040"
                        }
                      ]
                    }
                  }
                },
                "cluster_list": {
                  "type": "array",
