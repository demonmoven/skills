      "GetDeploymentTicket": {
        "BOE": {
          "description": "查询部署工单详情 (BOE)",
          "http_request_metadata": {
            "method": "GET",
            "url": "https://cloud-boe.bytedance.net/api/v1/tce/open-apis/v2/deployment/{ticket_id}/",
            "querySchema": {
              "type": "object",
              "properties": {
                "ticket_id": {
                  "type": "string",
                  "description": "部署工单 ID（用于 URL 路径）"
                },
                "steps": {
                  "type": "string",
                  "description": "步骤过滤（留空返回全部）",
                  "default": ""
                },
                "use_pods_list": {
                  "type": "boolean",
                  "description": "是否返回 Pod 列表",
                  "default": true
                }
              },
              "required": [
                "ticket_id"
              ]
            },
            "headerSchema": {
              "type": "object",
              "properties": {
                "x-bcgw-tenant-id": {
                  "type": "string",
                  "default": "bytedance",
                  "description": "租户 ID"
                },
                "accept-language": {
                  "type": "string",
                  "default": "zh",
                  "description": "语言"
                },
                "x-jwt-token": {
                  "type": "string",
                  "description": "JWT Token（用户身份认证）"
                }
              }
            },
            "outputSchema": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "properties": {
                    "meta": {
                      "type": "object",
                      "description": "工单元信息（id, deployment_type, status, psm, create_time, finish_time 等）"
                    },
                    "pipeline": {
                      "type": "object",
                      "description": "流水线信息（stages, allow_actions 等）",
                      "properties": {
                        "stages": {
                          "type": "array",
                          "description": "流水线阶段列表",
                          "items": {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string",
                                "description": "阶段名称"
                              },
                              "status": {
                                "type": "string",
                                "description": "阶段状态"
                              },
                              "steps": {
                                "type": "array",
                                "description": "阶段步骤列表"
                              }
                            }
                          }
                        }
                      }
                    },
                    "runtime": {
                      "type": "object",
                      "description": "运行时信息（cluster_list, diff_info 等）"
                    }
                  }
                }
              }
            }
          }
        },
