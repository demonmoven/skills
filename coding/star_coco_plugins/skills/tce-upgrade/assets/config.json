  "component": {
    "TCE": {
      "SearchService": {
        "BOE": {
          "description": "搜索 TCE 服务 (BOE)",
          "http_request_metadata": {
            "method": "GET",
            "url": "https://cloud-boe.bytedance.net/api/v1/tce/open-apis/v1/services/",
            "querySchema": {
              "type": "object",
              "properties": {
                "search": {
                  "type": "string",
                  "description": "搜索关键词（PSM 或服务名）"
                },
                "repo_name": {
                  "type": "string",
                  "description": "仓库名称"
                },
                "detail": {
                  "type": "boolean",
                  "description": "是否返回详细信息",
                  "default": true
                },
                "is_ppe": {
                  "type": "boolean",
                  "description": "是否为 PPE 环境",
                  "default": false
                },
                "page": {
                  "type": "integer",
                  "description": "页码",
                  "default": 1
                },
                "page_size": {
                  "type": "integer",
                  "description": "每页数量",
                  "default": 10
                },
                "subs_prefer": {
                  "type": "boolean",
                  "description": "是否优先展示订阅服务",
                  "default": true
                }
              },
              "required": []
            },
            "headerSchema": {
              "type": "object",
              "properties": {
                "x-bcgw-tenant-id": {
                  "type": "string",
                  "default": "bytedance",
                  "description": "租户 ID"
                },
                "accept-language": {
                  "type": "string",
                  "default": "zh",
                  "description": "语言"
                },
                "x-jwt-token": {
                  "type": "string",
                  "description": "JWT Token（用户身份认证）"
                }
              }
            },
            "outputSchema": {
              "type": "object",
              "properties": {
                "page_info": {
                  "type": "object",
                  "description": "分页信息",
                  "properties": {
                    "total_count": {
                      "type": "integer",
                      "description": "总数量"
                    },
                    "page_num": {
                      "type": "integer",
                      "description": "当前页码"
                    },
                    "page_size": {
                      "type": "integer",
                      "description": "每页数量"
                    }
                  }
                },
                "data": {
                  "type": "array",
                  "description": "服务列表",
                  "items": {
                    "type": "object",
                    "properties": {
                      "meta": {
                        "type": "object",
                        "description": "服务元信息（id, psm, name, status, cluster_ids 等）"
                      },
                      "auth": {
                        "type": "object",
                        "description": "权限信息（owner, iam_info, galaxy_info 等）"
                      },
                      "build": {
                        "type": "object",
                        "description": "构建信息（language, tech_stack, scm_repo_info 等）"
                      },
                      "runtime": {
                        "type": "object",
                        "description": "运行时信息（ports, cluster_ids, latest_repo_info 等）"
                      },
                      "upgrade": {
                        "type": "object",
                        "description": "升级信息（update_rely, upgrade_url）"
                      }
                    }
                  }
                }
              }
            }
          }
        },
