                },
                "idc": {
                  "type": "string",
                  "description": "机房标识（如 hl、boe），通过 GetClusters 获取"
                },
                "cluster": {
                  "type": "string",
                  "description": "集群名称（如 default），通过 GetClusters 获取",
                  "default": "default"
                },
                "env": {
                  "type": "string",
                  "description": "环境名称（如 prod），通过 GetEnvs 获取"
                },
                "online": {
                  "type": "boolean",
                  "description": "是否发送到线上环境（true=线上，false=BOE）",
                  "default": false
                },
                "rpc_context": {
                  "type": "array",
                  "description": "RPC 上下文参数",
                  "default": [],
                  "items": { "type": "object" }
                },
                "request_timeout": {
                  "type": "integer",
                  "description": "请求超时时间（毫秒）",
                  "default": 60000
                },
                "connect_timeout": {
                  "type": "integer",
                  "description": "连接超时时间（毫秒）",
                  "default": 60000
                },
                "source": {
                  "type": "integer",
                  "description": "来源标识",
                  "default": 1
                },
                "base": {
                  "type": "object",
                  "description": "基础配置",
                  "default": {}
                }
              },
              "required": [
                "psm",
                "func_name",
                "zone",
                "idc",
                "env"
              ]
            },
            "outputSchema": {
              "type": "object",
              "properties": {
                "error_code": {
                  "type": "integer",
                  "description": "错误码，0 表示成功"
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "resp_body": {
                      "type": "string",
                      "description": "目标服务的响应体（JSON 字符串）"
                    },
                    "log_id": {
                      "type": "string",
                      "description": "请求日志 ID"
                    },
                    "req_latency": {
                      "type": "string",
                      "description": "请求耗时"
                    },
                    "error": {
                      "type": "string",
                      "description": "错误信息"
                    },
                    "history_id": {
                      "type": "integer",
                      "description": "请求历史 ID"
                    },
                    "request_address": {
                      "type": "string",
                      "description": "实际请求地址"
                    },
                    "func_name": {
                      "type": "string",
                      "description": "RPC 方法名称"
                    },
                    "argos_link": {
                      "type": "string",
                      "description": "Argos 日志查询链接"
                    },
                    "biz_status_code": {
                      "type": "integer",
                      "description": "业务状态码"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
