{
  "name": "@byted/xdex",
  "version": "0.0.41",
  "description": "xdev — 统一 coding agent CLI: 5 个 agent (Trae CN / Trae / Coco / Claude Code / Codex) 切换 + plugin/skill 项目级分发 + trace 会话上报",
  "type": "module",
  "main": "dist/index.js",
