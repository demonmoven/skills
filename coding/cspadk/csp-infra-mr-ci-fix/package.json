{
  "name": "@i18n-cs/csp-infra-mr-ci-fix",
  "version": "1.3.1",
  "description": "Fetch CI check failures for current branch's MR via bytedcli and auto-fix the errors",
  "private": false,
  "keywords": [
    "ai-skill",
    "csp-infra"
  ],
  "skillConfig": {
    "source": "codebase",
    "owner": "i18n-cs",
    "repo": "ai-infra-i18n",
    "agentSupport": [
      "claude-code",
      "cursor"
    ]
  },
  "publishConfig": {
    "registry": "https://skills.bytedance.net/api/registry"
  }
}
